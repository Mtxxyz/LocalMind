{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalMind",
  "version": "0.1.0",
  "identifier": "com.localmind.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LocalMind",
        "width": 1240,
        "height": 820,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "decorations": false,
        "resizable": true,
        "visible": false
      },
      {
        "label": "capture",
        "title": "Quick Capture",
        "width": 460,
        "height": 300,
        "center": true,
        "decorations": true,
        "resizable": false,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "copyright": "LocalMind - private by design",
    "shortDescription": "Private local notes",
    "longDescription": "LocalMind is a minimal, offline-only notes app. All data stays on your device."
  }
}
